<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!--MVC - view-->
<HBox alignment="TOP_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="src.SpinnyController">
    <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="150.0" spacing="10.0">
        <Button onAction="#handlePressed" prefWidth="120.0" text="pyramid"/>
        <Button onAction="#handlePressed" prefWidth="125.0" text="rectangular pyramid"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="hexagonal pyramid"/>

        <Button onAction="#handlePressed" prefWidth="120.0" text="triangular prism"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="rectangular prism"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="pentagonal prism"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="hexagonal prism"/>

        <Button onAction="#handlePressed" prefWidth="120.0" text="tetrahedron"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="cube"/> <!-- aka hexahedron -->
        <Button onAction="#handlePressed" prefWidth="120.0" text="octahedron"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="dodecahedron"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="icosahedron"/>
        <Button onAction="#handlePressed" prefWidth="120.0" text="cuboctahedron"/>
<!--        <Button onAction="#handlePressed" prefWidth="140.0" text="truncated tetrahedron"/>-->

        <Button onAction="#handlePressed" prefWidth="120.0" text="truncated cube"/>
        <Button onAction="#handlePressed" prefWidth="140.0" text="truncated octahedron"/>

        <Button onAction="#handlePressed" prefWidth="120.0" text="snub cube"/>

<!--        <Button onAction="#handlePressed" prefWidth="145.0" text="rhombic dodecahedron"/>-->

    </VBox>
    <Pane fx:id="pane" prefHeight="400.0" prefWidth="400.0" HBox.hgrow="NEVER"/>
</HBox>
